CWD = $(shell pwd)
MACH = $(shell uname -m)
TRITON_TARGET = $(shell uname -m)

ifeq ($(MACH),aarch64)
  TRITON_TARGET = AArch64\;
endif

ifeq ($(MACH),x86_64)
  TRITON_TARGET = X86\;
endif

DEBUG_BUILD := 0

# Disable Sphinx.
HAVE_SPHINX := 0

CC = /usr/bin/gcc
CXX = /usr/bin/g++
CMAKE = /usr/bin/cmake
GMAKE = /usr/bin/gmake
GMAKE_NUMJOBS = -j4

SRCDIR = triton-gpu
TOPDIR = $(CWD)
TOPSRCDIR = $(TOPDIR)/$(SRCDIR)
TOPBUILDDIR = $(TOPDIR)/build-triton
TRITON_RUNPATH = $(TOPBUILDDIR)/lib
LD_LIBRARY_PATH =

# CUDA
CUDA_VERSION = 12.9
CUDA_TOP = /usr/local/cuda-$(CUDA_VERSION)
CUDA_LIBDIR = $(CUDA_TOP)/lib64
CUDA_TARGET_LIBDIR = $(CUDA_TOP)/targets/$(MACH)-linux/lib
CUDA_INCDIR = $(CUDA_TOP)/include
CUDA_TARGET_INCDIR = $(CUDA_TOP)/targets/$(MACH)-linux/include

# ROCm
ROCM_VERSION = 6.4.3
ROCM_PREFIX = /opt/rocm-$(ROCM_VERSION)
ROCM_LIBDIR = $(ROCM_PREFIX)/lib
ROCM_INCDIR = $(ROCM_PREFIX)/include

# LLVM
LLVM_VERSION = 21.1.1
LLVM_TRITON = /opt/triton/llvm-$(LLVM_VERSION)
LLVM_TRITON_LIBDIR = $(LLVM_TRITON)/lib64

PYTHON = /usr/bin/python3.13
PYTHON_EXECUTABLE = $(PYTHON)
PYTHON_LIBRARY = /usr/lib64/libpython3.13.so
PYTHON_LIBRARIES = /usr/lib64/libpython3.13.so
PYTHON_INCLUDE_DIRS = /usr/include/python3.13
SWIG = /usr/bin/swig
SWIG_EXECUTABLE = $(SWIG)

OFLAG = -O2
GFLAG = -g
ENABLE_EXPENSIVE_CHECKS = 0

ifeq ($(DEBUG_BUILD),1)
  OFLAG = -O0
  GFLAG = -g3
  ENABLE_EXPENSIVE_CHECKS = 1
  TOPBUILDDIR = $(TOPDIR)/build-triton-debug
endif

# Use this prefix when creating internal binaries.
CMAKE_PREFIX = /opt/triton/llvm-$(LLVM_VERSION)
CMAKE_INSTALL_BINDIR = $(CMAKE_PREFIX)/bin
CMAKE_INSTALL_LIBDIR = $(CMAKE_PREFIX)/lib64
CMAKE_INSTALL_LIBEXECDIR = $(CMAKE_PREFIX)/libexec
CMAKE_INSTALL_INCLUDEDIR = $(CMAKE_PREFIX)/include
CMAKE_INSTALL_DATADIR = $(CMAKE_PREFIX)/share
CMAKE_INSTALL_DATAROOTDIR = $(CMAKE_PREFIX)/share

CFLAGS = $(GFLAG) $(OFLAG) -pthread -std=c11 -fno-strict-aliasing
CFLAGS += -Wall -Wcast-align -Wno-long-long -Woverflow
CFLAGS += -Wno-unused-command-line-argument
CFLAGS += -Wstack-protector -ffunction-sections -fdata-sections
CFLAGS += -fstack-protector-all
CFLAGS += -fno-omit-frame-pointer -finput-charset=UTF-8 -fPIC
CFLAGS += -fuse-ld=gold

CXXFLAGS = $(GFLAG) $(OFLAG) -pthread -std=gnu++17 -fno-strict-aliasing
CXXFLAGS += -fexceptions -frtti -fstack-protector-all
CXXFLAGS += -Wall -Wcast-align -Wno-long-long -Woverflow
CXXFLAGS += -Wno-redundant-move -finput-charset=UTF-8 -fPIC
CXXFLAGS += -Wno-unused-command-line-argument -Wstack-protector
CXXFLAGS += -fdata-sections -ffunction-sections
CXXFLAGS += -fuse-ld=gold

CPPFLAGS = -D_REENTRANT -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
CPPFLAGS += -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS
CPPFLAGS += -D__STDC_LIMIT_MACROS
CPPFLAGS += -D_GNU_SOURCE -D_XOPEN_SOURCE=700
CPPFLAGS += -I$(CUDA_INCDIR)
CPPFLAGS += -I$(ROCM_INCDIR)
CPPFLAGS += -I$(CMAKE_PREFIX)/include

LLVM_BUILD_DIR = $(CWD)/triton-llvm-build
LLVM_INCLUDE_DIRS = $(LLVM_BUILD_DIR)/include
LLVM_LIBRARY_DIR = $(LLVM_BUILD_DIR)/lib64
LLVM_SYSPATH = $(LLVM_BUILD_DIR)
LLVM_EXTERNAL_LIT = $(LLVM_TRITON)/bin

LDFLAGS = -L$(TOPBUILDDIR)/lib
LDFLAGS += -L$(TOPBUILDDIR)/lib64
LDFLAGS += -L$(CUDA_LIBDIR)
LDFLAGS += -L$(ROCM_LIBDIR)
LDFLAGS += -L$(CMAKE_INSTALL_LIBDIR)
LDFLAGS += -L$(LLVM_LIBRARY_DIR)
LDFLAGS += -Wl,-rpath -Wl,$(CUDA_LIBDIR)
LDFLAGS += -Wl,-rpath -Wl,$(ROCM_LIBDIR)
LDFLAGS += -Wl,-rpath -Wl,$(LLVM_TRITON_LIBDIR)
LDFLAGS += -Wl,-rpath -Wl,$(CMAKE_INSTALL_LIBDIR)
LDFLAGS += -fuse-ld=gold

ifeq ($(DEBUG_BUILD),1)
  CPPFLAGS += -D_DEBUG
else
  CPPFLAGS += -DNDEBUG
endif

ifeq ($(ENABLE_EXPENSIVE_CHECKS),1)
  CPPFLAGS += -D_GLIBCXX_DEBUG -DXDEBUG
endif

TRITON_LIBEXECDIR = /usr/libexec
LIBFFI_INCDIR = /usr/include

CMAKE_OPTIONS = -DCMAKE_INSTALL_PREFIX:FILEPATH=$(CMAKE_PREFIX)
CMAKE_OPTIONS += -DCMAKE_C_COMPILER:FILEPATH=$(CC)
CMAKE_OPTIONS += -DCMAKE_CXX_COMPILER:FILEPATH=$(CXX)
CMAKE_OPTIONS += -DCMAKE_C_CFLAGS:STRING="$(CPPFLAGS) $(CFLAGS)"
CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS:STRING="$(CPPFLAGS) $(CXXFLAGS)"
CMAKE_OPTIONS += -DCMAKE_LINKER_TYPE:STRING=BFD
CMAKE_OPTIONS += -DCMAKE_EXE_LINKER_FLAGS:STRING="$(LDFLAGS) -fPIE"
CMAKE_OPTIONS += -DCMAKE_SHARED_LINKER_FLAGS:STRING="$(LDFLAGS) -fPIC"
CMAKE_OPTIONS += -DCMAKE_INSTALL_PREFIX:FILEPATH=$(CMAKE_PREFIX)
CMAKE_OPTIONS += -DCMAKE_AR:FILEPATH=/usr/bin/ar

CMAKE_OPTIONS += -DCMAKE_INSTALL_BINDIR:FILEPATH=$(CMAKE_INSTALL_BINDIR)
CMAKE_OPTIONS += -DCMAKE_INSTALL_LIBDIR:FILEPATH=$(CMAKE_INSTALL_LIBDIR)
CMAKE_OPTIONS += -DCMAKE_INSTALL_LIBEXECDIR:FILEPATH=$(CMAKE_INSTALL_LIBEXECDIR)
CMAKE_OPTIONS += -DCMAKE_INSTALL_INCLUDEDIR:FILEPATH=$(CMAKE_INSTALL_INCLUDEDIR)
CMAKE_OPTIONS += -DCMAKE_INSTALL_DATADIR:FILEPATH=$(CMAKE_INSTALL_DATADIR)
CMAKE_OPTIONS += -DCMAKE_INSTALL_DATAROOTDIR:FILEPATH=$(CMAKE_INSTALL_DATAROOTDIR)
CMAKE_OPTIONS += -DCMAKE_SUPPRESS_REGENERATION:BOOL=ON

CMAKE_OPTIONS += -DCMAKE_MAKE_PROGRAM:STRING="/usr/bin/gmake"
CMAKE_OPTIONS += -DCMAKE_ASM_COMPILER:STRING="$(CC)"
CMAKE_OPTIONS += -DCMAKE_BUILD_RPATH="$(TOPBUILDDIR)/lib\;$(TOPBUILDDIR)/lib64"
CMAKE_OPTIONS += -DCMAKE_INSTALL_RPATH="$(CMAKE_INSTALL_LIBDIR)"

ifeq ($(DEBUG_BUILD),1)
  CMAKE_OPTIONS += -DCMAKE_BUILD_TYPE:STRING=Debug
  CMAKE_OPTIONS += -DCMAKE_C_FLAGS_DEBUG:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS_DEBUG:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_ASM_FLAGS_DEBUG:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_ASM_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_C_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
else
  CMAKE_OPTIONS += -DCMAKE_BUILD_TYPE:STRING=Release
  CMAKE_OPTIONS += -DCMAKE_C_FLAGS_DEBUG:STRING="$(OFLAG)"
  CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS_DEBUG:STRING="$(OFLAG)"
  CMAKE_OPTIONS += -DCMAKE_ASM_FLAGS_DEBUG:STRING="$(OFLAG)"
  CMAKE_OPTIONS += -DCMAKE_ASM_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_C_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_C_FLAGS_RELEASE:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS_RELEASE:STRING="$(OFLAG) $(GFLAG)"
endif

CMAKE_OPTIONS += -DFFI_INCLUDE_DIR:STRING=$(LIBFFI_INCDIR)
CMAKE_OPTIONS += -DFFI_LIBRARY_DIR:STRING=$(LIBFFI_LIBDIR)

ifeq ($(HAVE_SPHINX),1)
  CMAKE_OPTIONS += -DSPHINX_EXECUTABLE:STRING="/usr/bin/sphinx-build"
  CMAKE_OPTIONS += -DTRITON_ENABLE_SPHINX:BOOL=ON
  CMAKE_OPTIONS += -DTRITON_BUILD_DOCS:BOOL=ON
  CMAKE_OPTIONS += -DSPHINX_OUTPUT_HTML:BOOL=ON
  CMAKE_OPTIONS += -DSPHINX_OUTPUT_MAN:BOOL=ON
  CMAKE_OPTIONS += -DSPHINX_WARNINGS_AS_ERRORS:BOOL=OFF
endif

CMAKE_OPTIONS += -DCMAKE_VERBOSE_MAKEFILE:BOOL=ON
CMAKE_OPTIONS += -DTRITON_BUILD_WITH_CLANG_LLD:BOOL=True

# Python
CMAKE_OPTIONS += -DPython3_EXECUTABLE:STRING=$(PYTHON)
CMAKE_OPTIONS += -DPYTHON:FILEPATH="$(PYTHON)"
CMAKE_OPTIONS += -DPYTHON_EXECUTABLE:FILEPATH="$(PYTHON)"
CMAKE_OPTIONS += -DPYTHON_LIBRARY:FILEPATH="$(PYTHON_LIBRARY)"
CMAKE_OPTIONS += -DPYTHON_LIBRARIES:FILEPATH="$(PYTHON_LIBRARIES)"
CMAKE_OPTIONS += -DPYTHON_INCLUDE_DIRS:FILEPATH="$(PYTHON_INCLUDE_DIRS)"
CMAKE_OPTIONS += -DSWIG_EXECUTABLE:FILEPATH="$(SWIG_EXECUTABLE)"

# LLVM
CMAKE_OPTIONS += -DLLVM_SYSPATH="$(LLVM_SYSPATH)"
CMAKE_OPTIONS += -DLLVM_EXTERNAL_LIT="$(LLVM_EXTERNAL_LIT)"
CMAKE_OPTIONS += -DLLVM_CMAKE_DIR=$(CMAKE_INSTALL_PREFIX)/lib64/cmake/llvm

# MLIR
MLIR_DIR = $(CMAKE_INSTALL_PREFIX)/lib64/cmake/mlir
MLIR_CMAKE_DIR = $(MLIR_DIR)
CMAKE_OPTIONS += -DMLIR_DIR=$(MLIR_DIR)
CMAKE_OPTIONS += -DMLIR_CMAKE_DIR=$(MLIR_CMAKE_DIR)

# CUDA + CUPTI
CMAKE_OPTIONS += -DCUDA_INCLUDE_DIR="$(CUDA_INCDIR)"
CMAKE_OPTIONS += -DCUDA_LIBRARY_DIR="$(CUDA_LIBDIR)"
CMAKE_OPTIONS += -DCUPTI_INCLUDE_DIR="$(CUDA_TOP)/targets/x86_64-linux/include"
CMAKE_OPTIONS += -DCUPTI_LIB_DIR="$(CUDA_TOP)/targets/x86_64-linux/lib"

# AMD ROCm
CMAKE_OPTIONS += -DROCM_INCLUDE_DIR="$(ROCM_INCDIR)"
CMAKE_OPTIONS += -DROCM_LIBRARY_DIR="$(ROCM_LIBDIR)"
CMAKE_OPTIONS += -DROCTRACER_PREFIX="$(ROCM_PREFIX)"
CMAKE_OPTIONS += -DROCTRACER_INCLUDE_DIR="$(ROCM_INCDIR)"
CMAKE_OPTIONS += -DROCTRACER_LIB_DIR="$(ROCM_LIBDIR)"

# Triton
CMAKE_OPTIONS += -DTRITON_WHEEL_DIR=$(LLVM_BUILD_DIR)

TRITON_BUILD_ENV = CC="$(CC)"
TRITON_BUILD_ENV += CXX="$(CXX)"
TRITON_BUILD_ENV += CFLAGS="$(CFLAGS)"
TRITON_BUILD_ENV += CXXFLAGS="$(CXXFLAGS)"
TRITON_BUILD_ENV += LDFLAGS="$(LDFLAGS)"
TRITON_BUILD_ENV += LD_OPTIONS="$(LD_OPTIONS)"
TRITON_BUILD_ENV += PATH="$(PATH)"
TRITON_BUILD_ENV += LLVM_BUILD_DIR="$(LLVM_BUILD_DIR)"
TRITON_BUILD_ENV += LLVM_INCLUDE_DIRS="$(LLVM_INCLUDE_DIRS)"
TRITON_BUILD_ENV += LLVM_LIBRARY_DIR="$(LLVM_LIBRARY_DIR)"
TRITON_BUILD_ENV += LLVM_SYSPATH="$(LLVM_SYSPATH)"
TRITON_BUILD_ENV += LLVM_DIR="$(LLVM_CMAKE_DIR)"
TRITON_BUILD_ENV += LLVM_CMAKE_DIR="$(LLVM_CMAKE_DIR)"
TRITON_BUILD_ENV += MLIR_DIR="$(MLIR_DIR)"
TRITON_BUILD_ENV += LLVM_EXTERNAL_LIT="$(LLVM_EXTERNAL_LIT)"
TRITON_BUILD_ENV += PKG_CONFIG_PATH="$(CUDA_LIBDIR)/pkgconfig"
TRITON_BUILD_ENV += PYTHON="$(PYTHON)"
TRITON_BUILD_ENV += PYTHON_LIBRARY="$(PYTHON_LIBRARY)"
TRITON_BUILD_ENV += LANG="C"
TRITON_BUILD_ENV += LC_ALL="C"

configure:
	( cd $(TOPSRCDIR) ; \
	  mkdir -p $(TOPBUILDDIR) ; \
	  if [ ! -f $(TOPBUILDDIR)/.configured ] ; \
	    then echo "Configuring $(TRITON_TARGET) TRITON with $(CMAKE) $(CMAKE_OPTIONS)" ; \
	    cd $(TOPBUILDDIR) ; \
	    /usr/bin/env - $(TRITON_BUILD_ENV) $(CMAKE) $(CMAKE_OPTIONS) $(TOPSRCDIR) ; \
	    if [ $$? -eq 0 ] ; \
	    then \
	    	cd $(TOPBUILDDIR) ; \
	    	touch $(TOPBUILDDIR)/.configured ; \
	    else \
		echo "Failure configuring $(TRITON_TARGET) TRITON." ; \
		exit 1; \
	     fi \
	  else \
	    	echo "TRITON has already been configured." ; \
	  fi )

confclean:
	  rm -f $(TOPBUILDDIR)/.configured

build: configure
	( if [ ! -d $(TOPBUIDDIR) ] || [ ! -f $(TOPBUILDDIR)/.configured ] ; \
	    then echo "TRITON has not been configured" ; \
	  else \
	    cd $(TOPBUILDDIR) ; \
	    $(GMAKE) $(GMAKE_NUMJOBS) ; \
	    touch $(TOPBUILDDIR)/.built ; \
	  fi )

clean:
	( if [ -f $(TOPBUIDLDIR) ] ; \
	    then cd $(TOPBUILDDIR) ; \
	    $(GMAKE) clean ; \
	    rm -f $(TOPBUILDDIR)/.built ; \
	  fi )

clobber:
	  rm -rf $(TOPBUILDDIR)

all: build


