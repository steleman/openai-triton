CWD = $(shell pwd)
MACH = $(shell uname -m)
LLVM_TARGETS := X86\;NVPTX\;AMDGPU
ENABLE_CUDA := 0
DEBUG_BUILD := 0

# Disable Sphinx.
HAVE_SPHINX := 0

CC = /usr/bin/gcc
CXX = /usr/bin/g++
CMAKE = /usr/bin/cmake
GMAKE = /usr/bin/gmake
GMAKE_NUMJOBS = -j4

LLVM_VERSION = triton
SRCDIR = llvm-$(LLVM_VERSION)
TOPDIR = $(CWD)
TOPSRCDIR = $(TOPDIR)/$(SRCDIR)
TOPBUILDDIR = $(TOPDIR)/triton-llvm-build
LLVM_RUNPATH = $(TOPBUILDDIR)/lib
LLVM_CONFIG = $(TOPBUILDDIR)/bin/llvm-config
CUDA_VERSION = 12.9
CUDA_PREFIX = /usr/local/cuda-$(CUDA_VERSION)
ROCM_VERSION = 6.4.3
ROCM_PREFIX = /opt/rocm-$(ROCM_VERSION)
LD_LIBRARY_PATH =
PATH = $(CUDA_PREFIX)/bin:$(ROCM_PREFIX)/bin:/usr/bin:/usr/sbin:/usr/local/bin
OPENMP_LLVM_TOOLS_DIR = $(TOPBUILDDIR)/lib/clang/$(CLANG_VERSION)/include

PYTHON = /usr/bin/python3.13
PYTHON_EXECUTABLE = $(PYTHON)
PYTHON_LIBRARY = /usr/lib64/libpython3.13.so
PYTHON_LIBRARIES = /usr/lib64/libpython3.13.so
PYTHON_INCLUDE_DIRS = /usr/include/python3.13
SWIG = /usr/bin/swig
SWIG_EXECUTABLE = $(SWIG)

OFLAG = -O2
GFLAG = -g
ENABLE_EXPENSIVE_CHECKS = 0

ifeq ($(DEBUG_BUILD),1)
  OFLAG = -O0
  GFLAG = -g3
  ENABLE_EXPENSIVE_CHECKS = 1
  TOPBUILDDIR = $(TOPDIR)/triton-llvm-build-debug
endif

# Use this prefix when creating internal binaries.
CMAKE_PREFIX = /opt/triton/llvm-21.1.1
CMAKE_INSTALL_BINDIR = $(CMAKE_PREFIX)/bin
CMAKE_INSTALL_LIBDIR = $(CMAKE_PREFIX)/lib64
CMAKE_INSTALL_LIBEXECDIR = $(CMAKE_PREFIX)/libexec
CMAKE_INSTALL_INCLUDEDIR = $(CMAKE_PREFIX)/include
CMAKE_INSTALL_DATADIR = $(CMAKE_PREFIX)/share
CMAKE_INSTALL_DATAROOTDIR = $(CMAKE_PREFIX)/share

CFLAGS = $(GFLAG) $(OFLAG) -pthread -std=c11 -fno-strict-aliasing
CFLAGS += -Wall -Wcast-align -Wno-long-long -Woverflow
CFLAGS += -Wno-unused-command-line-argument
CFLAGS += -Wstack-protector -ffunction-sections -fdata-sections
CFLAGS += -fkeep-static-consts -fstack-protector-all
CFLAGS += -fno-omit-frame-pointer -finput-charset=UTF-8 -fPIC
CFLAGS += -fuse-ld=gold
CFLAGS += -Wl,-rpath -Wl,$(CMAKE_INSTALL_LIBDIR)
CFLAGS += -Wl,-rpath -Wl,$(CUDA_PREFIX)/lib64
CFLAGS += -Wl,-rpath -Wl,$(CUDA_PREFIX)/targets/x86_64-linux/lib
CFLAGS += -Wl,-rpath -Wl,$(ROCM_PREFIX)/lib
CFLAGS += -Wl,-O3

CXXFLAGS = $(GFLAG) $(OFLAG) -pthread -std=c++17 -fno-strict-aliasing
CXXFLAGS += -fexceptions -frtti -fstack-protector-all
CXXFLAGS += -Wall -Wcast-align -Wno-long-long -Woverflow
CXXFLAGS += -Wno-redundant-move -finput-charset=UTF-8 -fPIC
CXXFLAGS += -Wno-unused-command-line-argument
CXXFLAGS += -Wstack-protector -fkeep-static-consts
CXXFLAGS += -fdata-sections -ffunction-sections
CXXFLAGS += -fuse-ld=gold
CXXFLAGS += -Wl,-rpath -Wl,$(CMAKE_INSTALL_LIBDIR)
CXXFLAGS += -Wl,-rpath -Wl,$(CUDA_PREFIX)/lib64
CXXFLAGS += -Wl,-rpath -Wl,$(CUDA_PREFIX)/targets/x86_64-linux/lib
CXXFLAGS += -Wl,-rpath -Wl,$(ROCM_PREFIX)/lib
CXXFLAGS += -Wl,-O3

CPPFLAGS = -D_REENTRANT -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
CPPFLAGS += -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS
CPPFLAGS += -D__STDC_LIMIT_MACROS
CPPFLAGS += -D_GNU_SOURCE -D_XOPEN_SOURCE=700
CPPFLAGS += -I$(CUDA_PREFIX)/include
CPPFLAGS += -I$(CUDA_PREFIX)/targets/x86_64-linux/include
CPPFLAGS += -I$(ROCM_PREFIX)/include
CPPFLAGS += -I$(CMAKE_PREFIX)/include

LDFLAGS = -L$(TOPBUILDDIR)/lib
LDFLAGS += -L$(TOPBUILDDIR)/lib64
LDFLAGS += -L$(CUDA_PREFIX)/lib64
LDFLAGS += -L$(CUDA_PREFIX)/targets/x86_64-linux/lib
LDFLAGS += -L$(ROCM_PREFIX)/lib
LDFLAGS += -L$(CMAKE_INSTALL_LIBDIR)
LDFLAGS += -Wl,-rpath -Wl,$(CMAKE_INSTALL_LIBDIR)
LDFLAGS += -Wl,-rpath -Wl,$(CUDA_PREFIX)/lib64
LDFLAGS += -Wl,-rpath -Wl,$(CUDA_PREFIX)/targets/x86_64-linux/lib
LDFLAGS += -Wl,-rpath -Wl,$(ROCM_PREFIX)/lib
LDFLAGS += -Wl,-O3
LDFLAGS += -fuse-ld=gold

CMAKE_BUILD_RPATH = $(CUDA_PREFIX)/lib64\;$(CUDA_PREFIX)/targets/x86_64-linux/lib\;
CMAKE_BUILD_RPATH += $(ROCM_PREFIX)/lib\;$(TOPBUILDDIR)/lib\;$(TOPBUILDDIR)/lib64

CMAKE_INSTALL_RPATH = $(CUDA_PREFIX)/lib64\;$(CUDA_PREFIX)/targets/x86_64-linux/lib\;
CMAKE_INSTALL_RPATH += $(ROCM_PREFIX)/lib\;$(CMAKE_INSTALL_LIBDIR)

ifeq ($(DEBUG_BUILD),1)
  CPPFLAGS += -D_DEBUG
else
  CPPFLAGS += -DNDEBUG
endif

ifeq ($(ENABLE_EXPENSIVE_CHECKS),1)
  CPPFLAGS += -D_GLIBCXX_DEBUG -DXDEBUG
endif

LLVM_LIBEXECDIR = /usr/libexec
LIBFFI_INCDIR = /usr/include

CMAKE_OPTIONS = -DCMAKE_C_COMPILER:FILEPATH=$(CC)
CMAKE_OPTIONS += -DCMAKE_CXX_COMPILER:FILEPATH=$(CXX)
CMAKE_OPTIONS += -DCMAKE_C_CFLAGS:STRING="$(CPPFLAGS) $(CFLAGS)"
CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS:STRING="$(CPPFLAGS) $(CXXFLAGS)"
CMAKE_OPTIONS += -DCMAKE_EXE_LINKER_FLAGS:STRING="$(LDFLAGS) -fPIE"
CMAKE_OPTIONS += -DCMAKE_SHARED_LINKER_FLAGS:STRING="$(LDFLAGS) -fPIC"
CMAKE_OPTIONS += -DCMAKE_INSTALL_PREFIX:FILEPATH=$(CMAKE_PREFIX)
CMAKE_OPTIONS += -DCMAKE_AR:FILEPATH=/usr/bin/ar

CMAKE_OPTIONS += -DCMAKE_INSTALL_BINDIR:STRING="$(CMAKE_INSTALL_BINDIR)"
CMAKE_OPTIONS += -DCMAKE_INSTALL_LIBDIR:STRING="$(CMAKE_INSTALL_LIBDIR)"
CMAKE_OPTIONS += -DCMAKE_INSTALL_LIBEXECDIR:STRING="$(CMAKE_INSTALL_LIBEXECDIR)"
CMAKE_OPTIONS += -DCMAKE_INSTALL_INCLUDEDIR:STRING="$(CMAKE_INSTALL_INCLUDEDIR)"
CMAKE_OPTIONS += -DCMAKE_INSTALL_DATADIR:STRING="$(CMAKE_INSTALL_DATADIR)"
CMAKE_OPTIONS += -DCMAKE_INSTALL_DATAROOTDIR:STRING="$(CMAKE_INSTALL_DATAROOTDIR)"
CMAKE_OPTIONS += -DCMAKE_SUPPRESS_REGENERATION:BOOL=ON

CMAKE_OPTIONS += -DLLVM_TARGETS_TO_BUILD:STRING="$(LLVM_TARGETS)"

CMAKE_OPTIONS += -DCMAKE_MAKE_PROGRAM:STRING="/usr/bin/gmake"
CMAKE_OPTIONS += -DCMAKE_ASM_COMPILER:STRING="$(CC)"
CMAKE_OPTIONS += -DCMAKE_BUILD_RPATH="$(CMAKE_BUILD_RPATH)"
CMAKE_OPTIONS += -DCMAKE_INSTALL_RPATH="$(CMAKE_INSTALL_RPATH)"
CMAKE_OPTIONS += -DLLVM_LIBDIR_SUFFIX:STRING="64"
CMAKE_OPTIONS += -DLLVM_BUILD_TOOLS:BOOL=ON
CMAKE_OPTIONS += -DLLVM_INCLUDE_TOOLS:BOOL=ON
CMAKE_OPTIONS += -DLLVM_BUILD_TESTS:BOOL=ON
CMAKE_OPTIONS += -DLLVM_INCLUDE_TESTS:BOOL=ON
CMAKE_OPTIONS += -DLLVM_ENABLE_THREADS:BOOL=ON
CMAKE_OPTIONS += -DLLVM_BUILD_32_BITS:BOOL=OFF

ifeq ($(DEBUG_BUILD),1)
  CMAKE_OPTIONS += -DCMAKE_BUILD_TYPE:STRING=Debug
  CMAKE_OPTIONS += -DCMAKE_C_FLAGS_DEBUG:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS_DEBUG:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_ASM_FLAGS_DEBUG:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_ASM_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_C_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DLLVM_ENABLE_ASSERTIONS:BOOL=ON
  CMAKE_OPTIONS += -DLLVM_ENABLE_EXPENSIVE_CHECKS:BOOL=ON
else
  CMAKE_OPTIONS += -DCMAKE_BUILD_TYPE:STRING=Release
  CMAKE_OPTIONS += -DCMAKE_C_FLAGS_DEBUG:STRING="$(OFLAG)"
  CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS_DEBUG:STRING="$(OFLAG)"
  CMAKE_OPTIONS += -DCMAKE_ASM_FLAGS_DEBUG:STRING="$(OFLAG)"
  CMAKE_OPTIONS += -DCMAKE_ASM_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_C_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS_RELWITHDEBINFO:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_C_FLAGS_RELEASE:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DCMAKE_CXX_FLAGS_RELEASE:STRING="$(OFLAG) $(GFLAG)"
  CMAKE_OPTIONS += -DLLVM_ENABLE_ASSERTIONS:BOOL=OFF
  CMAKE_OPTIONS += -DLLVM_ENABLE_EXPENSIVE_CHECKS:BOOL=OFF
endif

CMAKE_OPTIONS += -DLLVM_BUILD_EXAMPLES:BOOL=OFF
CMAKE_OPTIONS += -DLLVM_INCLUDE_EXAMPLES:BOOL=OFF
CMAKE_OPTIONS += -DLLVM_ENABLE_EH:BOOL=ON
CMAKE_OPTIONS += -DLLVM_ENABLE_PIC:BOOL=ON
CMAKE_OPTIONS += -DLLVM_ENABLE_RTTI:BOOL=ON
CMAKE_OPTIONS += -DLLVM_ENABLE_WARNINGS:BOOL=ON
CMAKE_OPTIONS += -DLLVM_ENABLE_PEDANTIC:BOOL=ON
CMAKE_OPTIONS += -DLLVM_ABI_BREAKING_CHECKS:STRING="FORCE_OFF"
CMAKE_OPTIONS += -DLLVM_ENABLE_ZLIB:BOOL=ON
CMAKE_OPTIONS += -DLLVM_ENABLE_FFI:BOOL=ON
CMAKE_OPTIONS += -DFFI_INCLUDE_DIR:STRING=$(LIBFFI_INCDIR)
CMAKE_OPTIONS += -DFFI_LIBRARY_DIR:STRING=$(LIBFFI_LIBDIR)
CMAKE_OPTIONS += -DLLVM_BINUTILS_INCDIR:STRING="/usr/include"
CMAKE_OPTIONS += -DLLVM_CONFIG:STRING=$(LLVM_CONFIG)

ifeq ($(HAVE_SPHINX),1)
  CMAKE_OPTIONS += -DSPHINX_EXECUTABLE:STRING="/usr/bin/sphinx-build"
  CMAKE_OPTIONS += -DLLVM_ENABLE_SPHINX:BOOL=ON
  CMAKE_OPTIONS += -DLLVM_BUILD_DOCS:BOOL=ON
  CMAKE_OPTIONS += -DSPHINX_OUTPUT_HTML:BOOL=ON
  CMAKE_OPTIONS += -DSPHINX_OUTPUT_MAN:BOOL=ON
  CMAKE_OPTIONS += -DSPHINX_WARNINGS_AS_ERRORS:BOOL=OFF
endif

CMAKE_OPTIONS += -DLLVM_BUILD_LLVM_DYLIB:BOOL=OFF
CMAKE_OPTIONS += -DLLVM_LINK_LLVM_DYLIB:BOOL=OFF
CMAKE_OPTIONS += -DCMAKE_VERBOSE_MAKEFILE:BOOL=ON
CMAKE_OPTIONS += -DLLVM_COMPILER_IS_GCC_COMPATIBLE:BOOL=ON
CMAKE_OPTIONS += -DLLVM_ENABLE_PROJECTS='llvm;clang;mlir;openmp;lld'
CMAKE_OPTIONS += -DLLVM_ENABLE_Z3_SOLVER:BOOL=ON
CMAKE_OPTIONS += -DLLVM_INSTALL_UTILS:BOOL=ON

# CUDA
NVPTX_ARCHS = sm_75\;sm_80\;sm_86\;sm_89\;sm_90\;sm_90a\;sm_100\;sm_100a\;sm_101\;sm_101a\;sm_120\;sm_120a

# OpenMP
CMAKE_OPTIONS += -DLIBOMP_ARCH=x86_64
CMAKE_OPTIONS += -DLIBOMP_LIB_TYPE=normal
CMAKE_OPTIONS += -DLIBOMP_OMP_VERSION=50
CMAKE_OPTIONS += -DLIBOMP_USE_INTERNODE_ALIGNMENT=on
CMAKE_OPTIONS += -DLIBOMP_USE_VERSION_SYMBOLS=on
CMAKE_OPTIONS += -DLIBOMP_ENABLE_SHARED=on
CMAKE_OPTIONS += -DLIBOMP_OMPT_SUPPORT=on
CMAKE_OPTIONS += -DLIBOMP_OMPT_BLAME=on
CMAKE_OPTIONS += -DLIBOMP_OMPT_TRACE=on
CMAKE_OPTIONS += -DLIBOMP_STATS=off
CMAKE_OPTIONS += -DLIBOMP_USE_DEBUGGER=off
CMAKE_OPTIONS += -DOPENMP_ENABLE_LIBOMPTARGET=on
CMAKE_OPTIONS += -DLIBOMPTARGET_NVPTX_ARCH:STRING=sm_75
CMAKE_OPTIONS += -DLIBOMPTARGET_DEVICE_ARCHITECTURES=$(NVPTX_ARCHS)
CMAKE_OPTIONS += -DLIBOMPTARGET_FOUND_NVIDIA_GPU:BOOL=True
CMAKE_OPTIONS += -DLIBOMPTARGET_FORCE_NVIDIA_TESTS:BOOL=True
CMAKE_OPTIONS += -DOPENMP_LLVM_TOOLS_DIR:FILEPATH=$(OPENMP_LLVM_TOOLS_DIR)

# MLIR
CMAKE_OPTIONS += -DMLIR_ENABLE_BINDINGS_PYTHON:BOOL=ON
CMAKE_OPTIONS += -DPython3_EXECUTABLE:STRING=$(PYTHON)

# Benchmarks
CMAKE_OPTIONS += -DBENCHMARK_ENABLE_EXCEPTIONS=on
CMAKE_OPTIONS += -DHAVE_POSIX_REGEX=true
CMAKE_OPTIONS += -DHAVE_STEADY_CLOCK=true

# Python
CMAKE_OPTIONS += -DPYTHON:FILEPATH="$(PYTHON)"
CMAKE_OPTIONS += -DPYTHON_EXECUTABLE:FILEPATH="$(PYTHON)"
CMAKE_OPTIONS += -DPYTHON_LIBRARY:FILEPATH="$(PYTHON_LIBRARY)"
CMAKE_OPTIONS += -DPYTHON_LIBRARIES:FILEPATH="$(PYTHON_LIBRARIES)"
CMAKE_OPTIONS += -DPYTHON_INCLUDE_DIRS:FILEPATH="$(PYTHON_INCLUDE_DIRS)"
CMAKE_OPTIONS += -DSWIG_EXECUTABLE:FILEPATH="$(SWIG_EXECUTABLE)"

LLVM_BUILD_ENV = CC="$(CC)"
LLVM_BUILD_ENV += CXX="$(CXX)"
LLVM_BUILD_ENV += CFLAGS="$(CFLAGS)"
LLVM_BUILD_ENV += CXXFLAGS="$(CXXFLAGS)"
LLVM_BUILD_ENV += LDFLAGS="$(LDFLAGS)"
LLVM_BUILD_ENV += LD_OPTIONS="$(LD_OPTIONS)"
LLVM_BUILD_ENV += PATH="$(PATH)"
LLVM_BUILD_ENV += PYTHON="$(PYTHON)"
LLVM_BUILD_ENV += PYTHON_LIBRARY="$(PYTHON_LIBRARY)"
LLVM_BUILD_ENV += OPENMP_LLVM_TOOLS_DIR="$(OPENMP_LLVM_TOOLS_DIR)"
LLVM_BUILD_ENV += LANG="C"
LLVM_BUILD_ENV += LC_ALL="C"

configure:
	( cd $(TOPSRCDIR) ; \
	  mkdir -p $(TOPBUILDDIR) ; \
	  if [ ! -f $(TOPBUILDDIR)/.configured ] ; \
	    then echo "Configuring $(LLVM_TARGETS) LLVM with $(CMAKE) $(CMAKE_OPTIONS)" ; \
	    cd $(TOPBUILDDIR) ; \
	    /usr/bin/env - $(LLVM_BUILD_ENV) $(CMAKE) $(CMAKE_OPTIONS) $(TOPSRCDIR)/llvm ; \
	    if [ $$? -eq 0 ] ; \
	    then \
	    	cd $(TOPBUILDDIR) ; \
	    	touch $(TOPBUILDDIR)/.configured ; \
	    else \
		echo "Failure configuring $(LLVM_TARGETS) LLVM." ; \
		exit 1; \
	     fi \
	  else \
	    	echo "LLVM has already been configured." ; \
	  fi )

confclean:
	  rm -f $(TOPBUILDDIR)/.configured

build: configure
	( if [ ! -d $(TOPBUIDDIR) ] || [ ! -f $(TOPBUILDDIR)/.configured ] ; \
	    then echo "LLVM has not been configured" ; \
	  else \
	    cd $(TOPBUILDDIR) ; \
	    $(GMAKE) $(GMAKE_NUMJOBS) ; \
	    touch $(TOPBUILDDIR)/.built ; \
	  fi )

clean:
	( if [ -f $(TOPBUIDLDIR) ] ; \
	    then cd $(TOPBUILDDIR) ; \
	    $(GMAKE) clean ; \
	    rm -f $(TOPBUILDDIR)/.built ; \
	  fi )

clobber:
	  rm -rf $(TOPBUILDDIR)

all: build


